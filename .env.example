# Copy to .env.local and fill in values for your own environment.
DATABASE_URL=
# Optional direct connection for Prisma migrations. Leave empty for local PostgreSQL.
DIRECT_DATABASE_URL=
# Separate, migrated database ending in _test.
TEST_DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000
COMMERCE_MODE=demo
# Leave empty locally. An approved hosted demo uses its exact HTTPS origin.
VEYRAVELUNE_PORTFOLIO_ORIGIN=
# Supply only in the private administrator provisioning shell.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
