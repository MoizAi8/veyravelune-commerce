generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PLACED
  PROCESSING
  COMPLETED
}

enum PaymentStatus {
  DEMO_CONFIRMED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String
  role Role @default(CUSTOMER)
  movements InventoryMovement[]
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  description String
  image String
  products Product[]
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  title String
  description String
  material String
  dimensions String
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id])
  active Boolean @default(true)
  featured Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images ProductImage[]
  variants Variant[]
  @@index([categoryId, active])
  @@index([material])
}

model ProductImage {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path String
  alt String
  sortOrder Int @default(0)
  @@unique([productId, sortOrder])
}

model Variant {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  sku String @unique
  finish String
  priceCents Int
  stock Int
  active Boolean @default(true)
  items OrderItem[]
  movements InventoryMovement[]
  @@index([productId, active])
  @@index([stock])
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  reference String @unique
  ownerHash String
  idempotencyKey String @db.Uuid
  fingerprint String
  status OrderStatus @default(PLACED)
  paymentStatus PaymentStatus @default(DEMO_CONFIRMED)
  mode String @default("DEMO")
  currency String @default("USD")
  subtotalCents Int
  shippingCents Int
  taxCents Int
  discountCents Int
  totalCents Int
  destination String
  createdAt DateTime @default(now())
  items OrderItem[]
  movements InventoryMovement[]
  @@unique([ownerHash, idempotencyKey])
  @@index([ownerHash, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id])
  variantId String @db.Uuid
  variant Variant @relation(fields: [variantId], references: [id])
  sku String
  title String
  finish String
  unitPriceCents Int
  quantity Int
  lineTotalCents Int
  @@index([orderId])
  @@index([variantId])
}

model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid
  variantId String @db.Uuid
  variant Variant @relation(fields: [variantId], references: [id])
  orderId String? @db.Uuid
  order Order? @relation(fields: [orderId], references: [id])
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id])
  delta Int
  reason String
  createdAt DateTime @default(now())
  @@index([variantId, createdAt])
}

model RateLimit {
  bucket String @id
  hits Int
  expiresAt DateTime
  @@index([expiresAt])
}
